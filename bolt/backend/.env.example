FLASK_ENV=production
HOST=0.0.0.0
PORT=5000

# Use PostgreSQL in production, for example:
# DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/traffic_vision
DATABASE_URL=sqlite:///instance/traffic.db

SECRET_KEY=replace-with-a-strong-random-secret
JWT_EXPIRATION_HOURS=24
CORS_ORIGINS=*
